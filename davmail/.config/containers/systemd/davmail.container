[Unit]
Description=DavMail Exchange gateway
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/davmail:latest
AutoUpdate=local
UserNS=keep-id
Volume=%h/.config/davmail:/config:Z
PublishPort=127.0.0.1:1143:1143
PublishPort=127.0.0.1:1025:1025

[Service]
Restart=always

[Install]
WantedBy=default.target