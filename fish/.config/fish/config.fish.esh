# TRAMP needs a Bourne-compatible shell with a plain prompt; fish's pure
# prompt never matches TRAMP's prompt regexp, so its parser loops forever
# (pinning a core) before it can switch to sh. TRAMP connects with a tty
# but sets TERM=dumb, so hand every dumb-terminal session off to sh. Real
# terminals keep a proper TERM, so interactive fish is unaffected.
if test "$TERM" = dumb
    exec sh
end

if status is-interactive
    # Commands to run in interactive sessions can go here
end

# Transient prompt: previous commands collapse to just the symbol
set --universal fish_transient_prompt 1

# Keep the working directory first (default), don't shorten paths
set --universal pure_begin_prompt_with_current_directory true
set --universal pure_shorten_prompt_current_directory_length 0

# Show venv name (you want this for uv/venv work)
set --universal pure_enable_virtualenv true

# Only show command duration when something took a while
set --universal pure_threshold_command_duration 5
set --universal pure_show_subsecond_command_duration false

set --universal pure_show_exit_status true        # set true if you want exit codes on failure
set --universal pure_check_for_new_release false    # avoid startup network check

# Ghostel integration
string match -qr '^ghostel(,|$)' -- "$INSIDE_EMACS"; and source "$EMACS_GHOSTEL_PATH/etc/shell/ghostel.fish"

fzf_configure_bindings \
--directory=ctrl-o \
--git_status=ctrl-g \
--git_log=alt-e \
--processes=alt-p \
--history=ctrl-r \
--variables=

fish_add_path ~/.local/bin
fish_add_path ~/.cargo/bin
fish_add_path /usr/local/texlive/2026/bin/x86_64-linux
fish_add_path /usr/sbin/

zoxide init fish | source

<% if [ $(hostname) = "alpinelaptop" ]; then %>

# musl ships no locale files, so a login shell with no LANG leaves every
# child (sway, and the Emacs daemon it starts) in the C/ASCII locale. Emacs
# then treats curved quotes as undisplayable and substitutes ASCII homoglyphs
# in the cyan `homoglyph' face. Emacs picks the coding system by matching
# "UTF-8" in the locale string, so C.UTF-8 works even without locale data.
# Guarded so an inherited locale (e.g. over SSH) is never clobbered.
set -q LANG; or set -gx LANG C.UTF-8

if status is-login
    # Create XDG_RUNTIME_DIR
    set -gx XDG_RUNTIME_DIR (mkrundir-rs)

    # Start default OpenRC user runlevel (not in SSH session)
    if not set -q SSH_CONNECTION; and not set -q SSH_CLIENT; and not set -q SSH_TTY
        openrc -U default
    end

    # Set dbus session address
    # (equivalent to sourcing /etc/user/conf.d/dbus)
    set -gx DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus"

    # Start sway if on tty1
    if test (tty) = /dev/tty1
        if test -x ~/.local/bin/start-sway
            exec "$HOME/.local/bin/start-sway"
        end
    end
end

<% fi -%>