{
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "lastChangelogVersion": "1.3.0",
  "extensions": [
    "-builtin:mcp"
  ],
  "defaultProvider": "opencode-go",
  "defaultModel": "kimi-k3.1-pro",
  "subagents": {
    "defaultModel": "opencode-go/deepseek-v4.1-flash",
    "defaultThinking": "medium",
    "agentOverrides": {
      "reviewer": {
        "model": "opencode-go/mimo-v2.6-pro"
      },
      "oracle": {
        "model": "opencode-go/mimo-v2.6-pro"
      }
    }
  }
}