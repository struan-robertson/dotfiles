# Read `man 5 sway` for a complete reference.

### Variables
set $mod Mod4
# Home row direction keys, like vim
set $left b
set $down n
set $up p
set $right f
# Terminal emulator
set $term $HOME/.local/bin/emacs-term
set $emacsclient "toolbox run --container dev emacsclient -c"
set $menu rofi -show drun

### Output configuration
output * bg /home/struan/.config/sway/wallpaper.jpg fill
# Use VRR on desktop widescreen 
output 'LG Electronics LG HDR WQHD 111NTPCAZ232' adaptive_sync on
# Smaller scale on oldlaptop
output 'Sharp Corporation LQ125T1JW02 Unknown' scale 1.5
# Laptop colour profile
output "Samsung Display Corp. 0x4163 Unknown" color_profile icc ~/.config/sway/color_profiles/xps13.icm

input type:touchpad accel_profile adaptive
input type:touchpad pointer_accel 0.5
input type:touchpad scroll_factor 1.0

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
exec systemctl --user start sway-session.target 

# Run emacs from here as it is limited as a Systemd service
exec toolbox run --container dev emacs --daemon

# Exec KeePassXC as it will need to be unlocked for most things
exec keepassxc
